<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mbc.dotto.dao.GrouphomeDao"> 


<!--그룹 정보 불러오기 -->
<select id="GetGroup" parameterType="int" resultType="com.mbc.dotto.dto.GrouphomeDto">
select  gr_no, gr_name, gr_leader, gr_count, gr_max, gr_code, gr_tree, gr_tier
from groups
where gr_no = #{grNo}
</select>



</mapper>
