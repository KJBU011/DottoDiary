<?xml version="1.0" encoding="UTF-8"?>
<!-- 아래복붙 -->
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--namespace 에서 다오랑 연결-->
<mapper namespace="com.mbc.dotto.dao.DiariesDao"> 

<select id="diaryList" parameterType="int" resultType="com.mbc.dotto.dto.DiariesDto">
select di_no, di_title, id, di_date, di_weather, di_public
<!--글번호, 글제목, 아이디, 날짜, 날씨, 공개여부 -->
from diaries 
where gr_no = #{grNo}
			<!-- 파라미터 -->
</select>



</mapper>